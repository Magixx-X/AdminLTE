<service>
  <id>HospitalQueryWorker</id><name>Information Query Worker</name><description>InformationQuerySystem durable queue worker</description>
  <startmode>Manual</startmode>
  <executable>%BASE%\..\.venv\Scripts\python.exe</executable><arguments>worker.py</arguments>
  <workingdirectory>%BASE%\..</workingdirectory><logpath>%BASE%\..\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>5</keepFiles></log>
  <onfailure action="restart" delay="10 sec"/><stoptimeout>195 sec</stoptimeout>
</service>
